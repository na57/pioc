# ============================================
# 个人智慧运行中心 (PIOC) 配置文件
# ============================================
# 请根据实际环境修改以下配置项
# ============================================

#------------------------------------------
# 应用服务器配置
#------------------------------------------
app:
  port: 8080
  name: "个人智慧运行中心"
  version: "1.0.0"
  description: "Personal Intelligence Operation Center"

#------------------------------------------
# 数据库配置 (MySQL)
#------------------------------------------
database:
  host: "localhost"
  port: 3306
  username: "root"
  password: "your-password-here"
  name: "mydb"
  connectionLimit: 10
  charset: "utf8mb4"

#------------------------------------------
# MongoDB 配置 (可选)
#------------------------------------------
mongodb:
  enabled: false
  host: "localhost"
  port: 27017
  username: "root"
  password: "root123"
  database: "mymongo"

#------------------------------------------
# Redis 配置 (可选)
#------------------------------------------
redis:
  enabled: false
  host: "localhost"
  port: 6379
  password: ""
  db: 0

#------------------------------------------
# 安全配置
#------------------------------------------
security:
  jwtSecret: "change-this-to-a-random-secret-key"
  jwtExpireDays: 7
  sessionCookieName: "pioc_auth_token"
  httpsEnabled: false

#------------------------------------------
# CAS/SSO 单点登录配置
#------------------------------------------
cas:
  enabled: true
  serverUrl: "https://ids.ynu.edu.cn"
  pathPrefix: "/authserver"
  serviceUrl: "http://localhost:8080"
  version: "3.0"
  strictSSL: true
  loginPath: "/login"
  validatePath: "/p3/serviceValidate"
  attributeMapping:
    username: "username"
    email: "email"
    name: "name"
  defaultRoleId: 2

#------------------------------------------
# 企业微信配置 (可选)
#------------------------------------------
wechat:
  enabled: false
  corpId: ""
  agentId: ""
  secret: ""

#------------------------------------------
# 日志配置
#------------------------------------------
logging:
  level: "info"
  format: "simple"
  output: "console"

#------------------------------------------
# CORS 配置
#------------------------------------------
cors:
  enabled: true
  allowedOrigins:
    - "http://localhost:8080"
  allowedMethods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "PATCH"
  allowedHeaders:
    - "Content-Type"
    - "Authorization"

#------------------------------------------
# 文件上传配置
#------------------------------------------
upload:
  maxFileSize: 10
  allowedTypes:
    - "jpg"
    - "jpeg"
    - "png"
    - "gif"
    - "pdf"
    - "doc"
    - "docx"
    - "xls"
    - "xlsx"
  storagePath: "./uploads"

#------------------------------------------
# 邮件配置 (可选)
#------------------------------------------
mail:
  enabled: false
  smtpHost: "smtp.example.com"
  smtpPort: 587
  smtpUsername: ""
  smtpPassword: ""
  fromAddress: "noreply@example.com"
  fromName: "PIOC 系统"

#------------------------------------------
# 本科教师授课信息应用配置
#------------------------------------------
apps:
  teacherTeaching:
    # 数据源ID（从数据源管理应用中获取）
    dataSourceId: ""
    # 学年学期表名
    semesterTableName: "t_yzsj_dm_xb_xnxqm"
    # 教师授课信息表名
    teachingInfoTableName: "t_dws_gxjx_bzksjsskxx_v11mx"
    # 课堂数据表名（AI课堂统计结果）
    classroomDataTableName: "t_ynu_gxjx_aikttjjg"
  myTeaching:
    # 数据源ID（从数据源管理应用中获取）
    dataSourceId: ""
    # 学年学期表名
    semesterTableName: "t_yzsj_dm_xb_xnxqm"
    # 教师授课信息表名
    teachingInfoTableName: "t_dws_gxjx_bzksjsskxx_v11mx"
  courseCenter:
    # 数据源ID（从数据源管理应用中获取）
    dataSourceId: ""
    # 本科生课程信息表名
    undergraduateCourseTableName: "t_dws_gxjx_bzkskcjbxxmx"
    # 研究生课程信息表名
    graduateCourseTableName: "t_dws_gxjx_yjskcxxmx"
    # 本科生教师授课信息表名
    undergraduateTeachingTableName: "t_dws_gxjx_bzksjsskxx_v11mx"
    # 研究生教师授课信息表名
    graduateTeachingTableName: "t_dws_gxjx_yjsjsskxxmx"
    # 课堂统计数据表名
    classroomStatsTableName: "t_ynu_gxjx_aikttjjg"

#------------------------------------------
# AI 模型配置 (OpenAI 兼容)
#------------------------------------------
ai:
  # 是否启用 AI 功能
  enabled: true
  # AI 模型提供商列表
  providers:
    # 提供商配置示例 1：OpenAI
    - name: "OpenAI"
      providerId: "openai"
      baseUrl: "https://api.openai.com/v1"
      apiKey: "sk-your-openai-api-key-here"
      models:
        - modelId: "gpt-4o"
          displayName: "GPT-4o"
          maxTokens: 8192
          temperature: 0.7
        - modelId: "gpt-4o-mini"
          displayName: "GPT-4o Mini"
          maxTokens: 4096
          temperature: 0.7
        - modelId: "gpt-3.5-turbo"
          displayName: "GPT-3.5 Turbo"
          maxTokens: 4096
          temperature: 0.7
    # 提供商配置示例 2：Azure OpenAI
    - name: "Azure OpenAI"
      providerId: "azure"
      baseUrl: "https://your-resource.openai.azure.com/openai/deployments"
      apiKey: "your-azure-api-key-here"
      models:
        - modelId: "gpt-4"
          displayName: "GPT-4"
          maxTokens: 8192
          temperature: 0.7
    # 提供商配置示例 3：自定义/本地部署
    - name: "本地模型"
      providerId: "local"
      baseUrl: "http://localhost:11434/v1"
      apiKey: "ollama"
      models:
        - modelId: "llama3.1"
          displayName: "Llama 3.1"
          maxTokens: 4096
          temperature: 0.7
        - modelId: "qwen2.5"
          displayName: "通义千问 2.5"
          maxTokens: 4096
          temperature: 0.7
  # 默认使用的模型（格式：providerId:modelId）
  defaultModel: "openai:gpt-4o-mini"
  # 请求超时时间（秒）
  timeout: 60
  # 最大重试次数
  maxRetries: 3

#------------------------------------------
# 系统功能开关
#------------------------------------------
features:
  allowUserRegistration: true
  enableCasLogin: true
  enableWechatLogin: false
  enableAuditLog: true
  enableRateLimit: true
  rateLimitPerMinute: 60
